# TSK-056: MQTT sobre TLS (8883) + auth. Valores reales solo en simulator/.env local (no versionado).
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_CERT=../docker/mqtt/certs/ca.crt
MQTT_USERNAME=simulator
MQTT_PASSWORD=
DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5433/coldchain
