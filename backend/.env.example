MQTT_HOST=localhost
DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5433/coldchain
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# TSK-056: MQTT sobre TLS (8883) + auth. Valores reales solo en backend/.env local (no versionado).
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_CERT=../docker/mqtt/certs/ca.crt
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Demo login users seeded by scripts/seed_demo_users.py (local dev only).
# Same password for the 4 roles, as offered by the frontend login screen.
DEMO_USER_PASSWORD=
