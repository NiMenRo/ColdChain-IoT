MQTT_HOST=localhost
DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5433/coldchain
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Public frontend origin used in password-reset links.
FRONTEND_BASE_URL=
# TSK-056: MQTT sobre TLS (8883) + auth. Valores reales solo en backend/.env local (no versionado).
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_CERT=../docker/mqtt/certs/ca.crt
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Demo login users seeded by scripts/seed_demo_users.py (local dev only).
# Same password for the 4 roles, as offered by the frontend login screen.
DEMO_USER_PASSWORD=
# Run-scoped simulator telemetry (coldchain.ps1 sets true for local runs).
# Default off: unit tests and plain uvicorn never spawn simulator processes.
COLDCHAIN_SIM_WORKER_ENABLED=
# QoS dispatch policy. Class quotas are the 4:2:1 selection cycle; all values
# must be positive. WFQ serves HIGH criticality bands, not device/sensor flows.
# Empty weights use H7=1, H8=2, H9=3. An override must define all three bands.
MAX_QUEUE_SIZE=1000
QOS_HIGH_QUOTA=4
QOS_MEDIUM_QUOTA=2
QOS_LOW_QUOTA=1
QOS_WFQ_BAND_WEIGHTS={"H7":1,"H8":2,"H9":3}
QOS_PENDING_CAPACITY=3000
QOS_RECENT_TRACE_CAPACITY=1000
QOS_RECENT_FAILURE_CAPACITY=100
# Maximum wait (seconds) for admitted work to drain when a run finishes.
QOS_DRAIN_TIMEOUT_S=30
# Optional measurement evidence. One append-only JSONL file per process.
# Store runtime files under the ignored .coldchain/ directory (absolute paths
# recommended). Empty disables capture; metrics are then unavailable.
TELEMETRY_TRACE_FILE=
# Equal non-empty domains assert synchronized clocks, not an automatic check.
TELEMETRY_CLOCK_DOMAIN=
# UI evidence: automatic capture per experiment using the managed local worker.
# Never imports the historical campaign or fabricates rates when disabled.
TELEMETRY_EVIDENCE_ENABLED=true
TELEMETRY_EVIDENCE_GRACE_S=2
# Optional absolute root; empty uses <repository>/.coldchain/evidence.
TELEMETRY_EVIDENCE_DIR=
# Notifications (Fase A/B): all optional. Local runs work with everything off.
# - Email: real SMTP only when SMTP_ENABLED=true AND host/from set; otherwise
#   email notifications persist as DISABLED (no network attempt, no SENT claim).
# - SMS: always simulated (log + persisted SIMULATED row, never a real send).
#   SMS_SIMULATED=false records DISABLED instead of simulating.
# - Push: decoupled adapter, Web Push NOT implemented. PUSH_ENABLED=true
#   records SIMULATED rows; default false records DISABLED.
# Real secrets live only in backend/.env local (never versionado).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=10
SMS_SIMULATED=true
PUSH_ENABLED=false
