MQTT_HOST=localhost
DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5433/coldchain
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
# Public frontend origin used in password-reset links.
FRONTEND_BASE_URL=
# TSK-056: MQTT sobre TLS (8883) + auth. Valores reales solo en backend/.env local (no versionado).
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA_CERT=../docker/mqtt/certs/ca.crt
MQTT_USERNAME=backend
MQTT_PASSWORD=
# Demo login users seeded by scripts/seed_demo_users.py (local dev only).
# Same password for the 4 roles, as offered by the frontend login screen.
DEMO_USER_PASSWORD=
# Run-scoped simulator telemetry (coldchain.ps1 sets true for local runs).
# Default off: unit tests and plain uvicorn never spawn simulator processes.
COLDCHAIN_SIM_WORKER_ENABLED=
# Notifications (Fase A/B): all optional. Local runs work with everything off.
# - Email: real SMTP only when SMTP_ENABLED=true AND host/from set; otherwise
#   email notifications persist as DISABLED (no network attempt, no SENT claim).
# - SMS: always simulated (log + persisted SIMULATED row, never a real send).
#   SMS_SIMULATED=false records DISABLED instead of simulating.
# - Push: decoupled adapter, Web Push NOT implemented. PUSH_ENABLED=true
#   records SIMULATED rows; default false records DISABLED.
# Real secrets live only in backend/.env local (never versionado).
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=10
SMS_SIMULATED=true
PUSH_ENABLED=false
