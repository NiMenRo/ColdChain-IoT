# Integracion HTTP con el backend FastAPI (TSK-048/049/050/052/053).
# Copie este archivo a .env.local (no versionado) y defina la URL real, p. ej.:
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Sin esta variable, apiFetch lanza NO_BASE_URL y las vistas muestran
# estado de configuracion. El login es real: POST /auth/login del backend;
# las cuentas demo deben existir en la API (scripts/create_admin.py).
VITE_API_BASE_URL=
